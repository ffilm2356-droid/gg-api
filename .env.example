# === GG-API Configuration ===
# Requires AIStudio2API running locally
# See SETUP-PROXY.md for full setup guide

# AIStudio2API proxy URL
PROXY_URL=http://127.0.0.1:2048

# API key (must match PROXY_API_KEY in AIStudio2API)
PROXY_API_KEY=

# Concurrent requests (higher = faster, but may hit rate limits)
CONCURRENCY=10

# Models
IMAGE_MODEL=gemini-2.0-flash-exp
VIDEO_MODEL=veo-2.0-generate-001
CHAT_MODEL=gemini-2.5-flash

# Max retries per prompt on failure
MAX_RETRIES=5

# Output directory
OUTPUT_DIR=./output

# Prompts file (CSV or JSON)
PROMPTS_FILE=./prompts.csv

# Log level: debug, info, warn, error
LOG_LEVEL=info
