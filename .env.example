# === GG-API Configuration ===

# Gemini API Keys (comma-separated) - get free keys at https://aistudio.google.com
# More keys = higher throughput. Each key gets ~15 RPM free tier.
# 10 keys = ~150 RPM = ~9000 images/hour = ~100K+ images/day
GEMINI_API_KEYS=key1,key2,key3

# Default model for image generation
IMAGE_MODEL=gemini-2.0-flash-exp

# Default model for video generation (if available)
VIDEO_MODEL=veo-2.0-generate-001

# Default model for chat/text
CHAT_MODEL=gemini-2.5-flash

# Concurrency: how many parallel requests per key
CONCURRENCY_PER_KEY=2

# Max retries on failure/rate-limit
MAX_RETRIES=5

# Retry delay base (ms) - exponential backoff applied
RETRY_DELAY_MS=2000

# Output directory for generated files
OUTPUT_DIR=./output

# Prompts file (CSV or JSON)
PROMPTS_FILE=./prompts.csv

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Image settings
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# Rate limit safety margin (ms between requests per key)
RATE_LIMIT_INTERVAL_MS=4200
